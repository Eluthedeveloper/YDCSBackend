PORT=7000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Set to true ONLY if the server runs behind a reverse proxy (Apache/nginx).
# When set, ratelimits key off X-Forwarded-For. Leave unset/false when the
# server is directly reachable, or clients can spoof the header to bypass
# rate limits.
TRUST_PROXY=false

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=audiostreaming

# Set REDIS_ENABLED=true if you run a Redis instance for caching
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=

CONTACT_RECEIVER=


# ---- HLS (on-demand) ----
# Tracks are packaged into HLS in the background after upload, then cached
# under uploads/hls. Tracks uploaded before HLS was enabled are packaged on
# their first play. ffmpeg must be on PATH (the Docker image installs it); the
# player falls back to the progressive .stream URL when it is unavailable.
# FFMPEG_PATH=ffmpeg
# HLS_SEGMENT_SECONDS=6
# HLS_AUDIO_BITRATE=128k
# HLS_MAX_CONCURRENCY=2
# HLS_FFMPEG_TIMEOUT_MS=300000
