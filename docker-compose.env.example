# Docker Compose environment for audiostreaming.
# Copy to .env and fill in, then run: docker compose up -d --build
# Never commit the filled-in .env.

# ---- Database ----
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
MYSQL_DATABASE=audiostreaming
MYSQL_USER=audio
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
# Loopback host port for the database. Use the same value as DB_PORT in
# backend/.env so a locally started backend talks to this container.
DB_HOST_PORT=3307

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating JWT_SECRET invalidates every existing session, so the admin is
# logged out everywhere after a change.
JWT_SECRET=REPLACE_WITH_48_BYTE_HEX_SECRET

# ---- Cache ----
# Set false to run without Redis (else Redis must be reachable at REDIS_HOST).
REDIS_ENABLED=true

# ---- SMTP (contact form) ----
# Use a Gmail App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_APP_PASSWORD
SMTP_FROM=REPLACE_WITH_SMTP_USER
SMTP_FROM_NAME=Yemisrach Dimts Media
CONTACT_RECEIVER=REPLACE_WITH_CONTACT_EMAIL
CONTACT_PHONE=

# ---- Web ----
# Host port mapped to the frontend (nginx)
WEB_PORT=8080